      },
      "period": {
        "zh": "草原信仰",
        "en": "Steppe belief"
      },
      "summary": {
        "zh": "以哈达、奶食、酒祭祀天地山川，祈求风调雨顺、人畜平安。",
        "en": "Offerings pray for good weather, peace, and abundance."
      },
      "image": "/static/assets/images/aobao1.jpg",
      "tags": [
        "祭敖包",
        "信仰"
      ]
    },

      },
      "period": {
        "zh": "战国至明清",
        "en": "Warring States to Ming-Qing"
      },
      "summary": {
        "zh": "托托城、沃野镇、砂井总管府等遗址呈现北方筑城、屯垦与治理线索。",
        "en": "Sites reveal city-building, farming colonies, and frontier governance."
      },
      "image": "/static/assets/images/yizhi.png",
      "tags": [
        "遗址",
        "古城"
      ]
    },
    {
      "id": "naadam",
      "category": "folk",
      "title": {

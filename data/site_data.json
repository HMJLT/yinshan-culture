  "civilization_cards": [
    {
      "id": "origin",
      "title": {
        "zh": "文明起源",
        "en": "Origins"
      },
      "summary": {
        "zh": "阴山岩画可追溯至旧石器时代晚期，记录狩猎、放牧、祭祀与星辰，是北方游牧民族无字的史诗。",
        "en": "Rock art dating back to the late Paleolithic records hunting, herding, rituals, and stars."
      },
      "image": "/static/assets/images/yanhua1.png"
    },
    {
      "id": "evolution",
      "title": {
        "zh": "历史演进",
        "en": "Evolution"
      },
      "summary": {
        "zh": "从赵长城到秦汉边塞，从鲜卑南迁到蒙元一统，阴山始终是农牧文明碰撞与交融的前沿。",
        "en": "From Zhao walls to Yuan unification, Yinshan witnessed frontier conflicts and fusion."
      },
      "image": "/static/assets/images/changcheng.jpg"
    },
    {
      "id": "ethnic",
      "title": {
        "zh": "民族融合",
        "en": "Ethnic Exchange"
      },
      "summary": {
        "zh": "匈奴、鲜卑、突厥、契丹、蒙古等多民族在阴山南北迁徙驻牧，形成了多元一体的文明格局。",
        "en": "Multiple ethnic groups migrated and settled across Yinshan, forming a diverse civilization."
      },
      "image": "/static/assets/images/minzujiaoron.jpg"
    },
    {
      "id": "trade",
      "title": {
        "zh": "草原丝路",
        "en": "Steppe Silk Road"
      },
      "summary": {
        "zh": "唐代参天可汗道、元代木怜道穿山而过，茶叶丝绸北上，马匹毛皮南下，连接欧亚大陆。",
        "en": "Trade routes through Yinshan connected the steppe, China, and Eurasia."
      },
      "image": "/static/assets/images/sichou.png"
    }
  ],

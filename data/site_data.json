  "resources": [
    {
      "id": "rock-art",
      "category": "rock",
      "title": {
        "zh": "阴山岩画艺术",
        "en": "Yinshan Rock Art"
      },
      "period": {
        "zh": "旧石器至元明",
        "en": "Paleolithic to Yuan-Ming"
      },
      "summary": {
        "zh": "题材涵盖狩猎、放牧、祭祀、星辰与战争，被称为北方游牧民族的无字史诗。",
        "en": "A visual epic of northern nomads, spanning hunting, herding, rituals, stars, and war."
      },
      "image": "/static/assets/images/yanhua1.png",
      "tags": [
        "岩画",
        "世界遗产预备名录"
      ]
    },
    {

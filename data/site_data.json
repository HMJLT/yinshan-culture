  "knowledge": {
    "zh": [
      {
        "keywords": [
          "岩画",
          "阴山岩画",
          "岩画价值"
        ],
        "answer": "阴山岩画分布点众多，题材包括狩猎、放牧、祭祀、星辰和战争。它像一部刻在山石上的北方民族史，适合用图像识别、GIS 和时间轴继续做深度数字化。"
      },
      {
        "keywords": [
          "那达慕",
          "男儿三艺",
          "摔跤",
          "赛马",
          "射箭"
        ],
        "answer": "那达慕是蒙古族传统竞技与节庆活动，核心项目是摔跤、赛马、射箭，也被称为“男儿三艺”。它是阴山活态民俗展示中最适合做互动体验的主题之一。"
      },
      {
        "keywords": [
          "祭敖包",
          "敖包"
        ],
        "answer": "祭敖包是草原社会重要的祭祀礼俗，人们献哈达、奶食和酒，围绕敖包祈求风调雨顺、人畜平安。"
      },
      {
        "keywords": [
          "赵长城",
          "长城",
          "高阙塞",
          "鸡鹿塞"
        ],
        "answer": "阴山沿线分布着赵长城、秦汉长城和高阙塞、鸡鹿塞等关隘。它们说明阴山既是边防线，也是农耕与游牧文明持续交流的走廊。"
      },
      {
        "keywords": [
          "草原丝路",
          "丝绸之路",
          "参天可汗道",
          "木怜道"
        ],
        "answer": "草原丝路穿越阴山，连接漠北、中原与欧亚大陆。茶叶、丝绸、马匹、毛皮等商品在这里流动，也带来了制度、语言和艺术的交流。"
      },
      {
        "keywords": [
          "数字人",
          "AI",
          "导览",
          "小使者"
        ],
        "answer": "阴山小使者是一位AI数字人导览助手，为您讲述阴山岩画、长城关隘、那达慕盛会和草原丝路的精彩故事。"
      }
    ],
    "en": [
      {
        "keywords": [
          "rock art",
          "petroglyph",
          "yinshan rock art"
        ],
        "answer": "Yinshan rock art records hunting, herding, rituals, stars, and war. It can be expanded with image recognition, GIS, and timeline-based interpretation."
      },
      {
        "keywords": [
          "naadam",
          "wrestling",
          "horse racing",

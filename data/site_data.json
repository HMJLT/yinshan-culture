  "timeline": [
    {
      "id": "neolithic",
      "era": {
        "zh": "新石器时代",
        "en": "Neolithic"
      },
      "title": {
        "zh": "岩画中的早期信仰",
        "en": "Early beliefs in rock art"
      },
      "period": {
        "zh": "早期文明线索",
        "en": "Early civilization clues"
      },
      "summary": {
        "zh": "阴山岩画记录狩猎、动物、天象与祭祀，是北方族群精神世界的视觉遗存。",
        "en": "Petroglyphs record hunting, animals, celestial symbols, and rituals."
      },
      "image": "/static/assets/images/yanhua1.png",
      "tags": [
        "岩画",
        "信仰",
        "狩猎"
      ]
    },
    {
      "id": "zhao",
      "era": {
        "zh": "战国赵",
        "en": "Zhao State"
      },
      "title": {
        "zh": "胡服骑射与赵长城",
        "en": "Riding reform and Zhao Great Wall"
      },
      "period": {
        "zh": "农牧边界重塑",
        "en": "Frontier transformation"
      },
      "summary": {
        "zh": "赵武灵王沿阴山修筑长城，胡服骑射开启农耕政权与草原世界的制度互动。",
        "en": "The Zhao frontier connected wall-building with cavalry reform."
      },
      "image": "/static/assets/images/changcheng.jpg",
      "tags": [
        "赵长城",
        "胡服骑射",
        "边塞"
      ]
    },
    {
      "id": "han-xiongnu",
      "era": {
        "zh": "秦汉匈奴",
        "en": "Qin-Han and Xiongnu"
      },
      "title": {
        "zh": "边塞关隘与草原通道",
        "en": "Frontier passes and steppe routes"
      },
      "period": {
        "zh": "交通与军事交汇",
        "en": "Routes and military exchange"
      },
      "summary": {
        "zh": "高阙塞、鸡鹿塞等关隘见证阴山作为军事防线与交流走廊的双重角色。",
        "en": "Gaoque and Jilu passes made Yinshan both a defense line and a corridor."
      },
      "image": "/static/assets/images/site1.jpg",
      "tags": [
        "高阙塞",
        "鸡鹿塞",
        "汉代"
      ]
    },
    {
      "id": "xianbei",
      "era": {
        "zh": "鲜卑北魏",
        "en": "Xianbei and Northern Wei"
      },
      "title": {
        "zh": "盛乐记忆与民族融合",
        "en": "Shengle memory and ethnic fusion"
      },
      "period": {
        "zh": "多民族交融",
        "en": "Multi-ethnic integration"
      },
      "summary": {
        "zh": "鲜卑、突厥、契丹、蒙古等族群在阴山南北迁徙、驻牧、融合，形成文明交汇带。",
        "en": "Groups migrated, settled, and fused across the Yinshan region."
      },
      "image": "/static/assets/images/minzujiaoron.jpg",
      "tags": [
        "鲜卑",
        "北魏",
        "民族融合"
      ]
    },
    {
      "id": "tang-yuan",
      "era": {
        "zh": "唐元交通",
        "en": "Tang-Yuan Routes"
      },
      "title": {
        "zh": "草原丝路的贸易网络",
        "en": "Trade networks of the steppe Silk Road"
      },
      "period": {
        "zh": "商贸枢纽",
        "en": "Commercial hub"
      },
      "summary": {
        "zh": "参天可汗道、木怜道穿过阴山，连接漠北、中原与更远的欧亚大陆。",
        "en": "Routes through Yinshan connected the steppe, China, and Eurasia."
      },
      "image": "/static/assets/images/sichou.png",
      "tags": [
        "草原丝路",
        "参天可汗道",
        "木怜道"
      ]
    },

      "period": {
        "zh": "服饰文化",
        "en": "Costume culture"
      },
      "summary": {
        "zh": "蒙古袍、珊瑚头饰与骑乘生活紧密相关，体现草原审美与礼仪秩序。",
        "en": "Robes and coral ornaments reflect steppe aesthetics and ritual order."
      },
      "image": "/static/assets/images/menggupao2.png",
      "tags": [
        "服饰",
        "礼仪"
      ]
    },
